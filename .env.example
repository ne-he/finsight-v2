# Copy to .env.local and fill in. Never commit the filled file.
# On Vercel these go in Project Settings, Environment Variables.

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key are safe in the browser: Row Level Security is what
# protects the data, not the secrecy of these two values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses Row Level Security. Server only. Never prefix this with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini -----------------------------------------------------------------
GEMINI_API_KEY=

# --- SEC EDGAR --------------------------------------------------------------
# EDGAR refuses requests without a descriptive User-Agent carrying contact
# details. Format: "Your Name your@email.com"
EDGAR_USER_AGENT=

# --- Limits (optional, defaults shown) --------------------------------------
# DAILY_LIMIT_PER_USER=40
# DAILY_LIMIT_GLOBAL=400

# --- Scheduled keep-alive (optional) ----------------------------------------
# Shared secret so only the scheduler can call /api/keep-alive.
# CRON_SECRET=
